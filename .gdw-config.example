# git-deploy-workflow user defaults
#
# Copy this file to ~/.gdw-config and uncomment any line you want to
# pre-set. Both bootstrap-deploy.sh and init-project.sh source it at
# startup. When a value is set here, the corresponding prompt is
# skipped entirely.
#
# Useful when you only have one GitHub account, one deploy server, etc.
# and you're tired of confirming the same defaults every time.
#
#   cp .gdw-config.example ~/.gdw-config
#   $EDITOR ~/.gdw-config

# ---------------------------------------------------------------------------
# init-project.sh defaults
# ---------------------------------------------------------------------------

# Your GitHub username. Skips the GH username prompt in init-project.
# GDW_DEFAULT_GH_USER="joeseverino"

# Default visibility for new GitHub repos created via init-project.
# One of: public, private
# GDW_DEFAULT_GH_VISIBILITY="private"

# ---------------------------------------------------------------------------
# bootstrap-deploy.sh defaults
# ---------------------------------------------------------------------------

# Default SSH host alias for the production server.
# Must match an entry in your local ~/.ssh/config.
# When set, bootstrap skips the SSH host alias prompt entirely.
# GDW_DEFAULT_SSH_HOST="jseverino.net"

# Default GitHub SSH hostname. Almost always "github.com".
# When set, bootstrap skips the "GitHub SSH host" prompt.
# GDW_DEFAULT_GITHUB_HOST="github.com"

# Default directory for zip review archives (<prefix>zip).
# The prefix and "-review.zip" suffix are appended automatically,
# e.g. with prefix "theme": $GDW_DEFAULT_ZIP_DIR/theme-review.zip
# GDW_DEFAULT_ZIP_DIR="$HOME/Downloads"

# Server-side GitHub SSH host alias pattern.
# __PREFIX__ is substituted with the command prefix at bootstrap time.
# Default when unset: github-__PREFIX__  (e.g. for prefix "theme" → github-theme)
# GDW_DEFAULT_SERVER_GITHUB_ALIAS="github-__PREFIX__"
